<Window x:Class="KitHerramientas.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KitHerramientas.Desktop.Controls"
        Title="NexoKit — Desktop R9 · Wi‑Fi Sensing" Height="800" Width="1120"
        MinHeight="680" MinWidth="920" WindowStartupLocation="CenterScreen"
        Background="#0E1117">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="KIT HERRAMIENTAS" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Desktop 0.9.0 · R9 · Wi‑Fi Sensing · actualizaciones por repositorio" Margin="0,5,0,0" Foreground="#AAB3C2"/>
            </StackPanel>
            <Button Grid.Column="1" Width="150" Height="42" Click="RefreshAll_Click" Content="↻  ACTUALIZAR" Background="#253044" Foreground="White" BorderBrush="#334155"/>
        </Grid>

        <TabControl Grid.Row="2" Background="#0E1117" Foreground="White" BorderBrush="#293241">
            <TabItem Header="Resumen">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="18" CornerRadius="12" Background="#171C25" BorderBrush="#293241" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RED ACTUAL" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatusText" Margin="0,8,0,0" Text="Cargando…" Foreground="White" FontSize="19"/>
                                <TextBlock x:Name="AdapterText" Margin="0,8,0,0" Foreground="#C8D0DC" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AdapterDescriptionText" Margin="0,5,0,0" Foreground="#AAB3C2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AdapterMacText" Margin="0,5,0,0" Foreground="#AAB3C2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ProfileText" Margin="0,5,0,0" Foreground="#AAB3C2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SpeedText" Margin="0,5,0,0" Foreground="#C8D0DC"/>
                                <TextBlock x:Name="DiagnosticText" Margin="0,8,0,0" Foreground="#E0B37A" TextWrapping="Wrap" Text="Diagnóstico: iniciando…"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0">
                                <TextBlock Text="DIRECCIONES" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                                <TextBlock x:Name="IpText" Margin="0,8,0,0" Foreground="White" FontSize="16"/>
                                <TextBlock x:Name="GatewayText" Margin="0,5,0,0" Foreground="White" FontSize="16"/>
                                <TextBlock x:Name="GatewayMacText" Margin="0,5,0,0" Foreground="#C8D0DC" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DnsText" Margin="0,5,0,0" Foreground="#C8D0DC" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PingText" Margin="0,5,0,0" Foreground="#C8D0DC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="WI‑FI" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WifiSsidText" Margin="0,8,0,0" Foreground="White" FontSize="16" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WifiBssidText" Margin="0,5,0,0" Foreground="#C8D0DC" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WifiSignalText" Margin="0,5,0,0" Foreground="#C8D0DC"/>
                                <TextBlock x:Name="WifiChannelText" Margin="0,5,0,0" Foreground="#C8D0DC"/>
                                <TextBlock x:Name="WifiRatesText" Margin="0,5,0,0" Foreground="#C8D0DC" TextWrapping="Wrap"/>
                                <Button Height="34" Margin="0,8,0,0" Click="OpenLocationSettings_Click" Content="PERMISOS WI‑FI / UBICACIÓN" Background="#253044" Foreground="White"/>
                                <TextBlock x:Name="WifiWarningText" Margin="0,8,0,0" Foreground="#E0B37A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="92" Click="Ping_Click" Background="#1D2633" Foreground="White" BorderBrush="#334155" FontSize="16" Content="⌁  Ping al gateway"/>
                        <Button Grid.Column="2" Height="92" Click="StartMonitor_Click" Background="#1D2633" Foreground="White" BorderBrush="#334155" FontSize="16" Content="📶  Abrir monitor de señal"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="SignalTab" Header="Señal en vivo">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MONITOR RSSI" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LiveSignalText" Text="—" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock x:Name="LiveSsidText" Text="—" Foreground="#AAB3C2"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="130" Height="42" Margin="8,0" Click="ToggleMonitor_Click" x:Name="MonitorButton" Content="INICIAR" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="2" Width="130" Height="42" Click="ClearHistory_Click" Content="LIMPIAR" Background="#1D2633" Foreground="White"/>
                    </Grid>
                    <Border Grid.Row="2" Background="#121821" BorderBrush="#293241" BorderThickness="1" CornerRadius="10" Padding="8">
                        <Canvas x:Name="SignalCanvas" MinHeight="310" SizeChanged="SignalCanvas_SizeChanged">
                            <Polyline x:Name="SignalPolyline" Stroke="#8EC5FF" StrokeThickness="3"/>
                        </Canvas>
                    </Border>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HistoryCountText" Text="Muestras: 0" Foreground="#AAB3C2"/>
                        <TextBlock Grid.Column="1" x:Name="HistoryAverageText" Text="Promedio: —" Foreground="#AAB3C2" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Estimación Windows: netsh % → dBm aprox." Foreground="#737F91" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="LabTab" Header="Laboratorio RSSI">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LABORATORIO RSSI · EXPERIMENTAL" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LabStatusText" Text="Calibrá el ambiente antes de iniciar una sesión." Foreground="White" FontSize="17" Margin="0,5,0,0"/>
                            <TextBlock x:Name="LabBaselineText" Text="Línea base: —" Foreground="#AAB3C2" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="125" Height="42" Margin="8,0" Click="LabCalibrate_Click" Content="CALIBRAR" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="2" x:Name="LabRunButton" Width="140" Height="42" Margin="0,0,8,0" Click="LabRun_Click" Content="INICIAR SESIÓN" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="3" x:Name="LabSensitivityButton" Width="160" Height="42" Click="LabSensitivity_Click" Content="SENSIBILIDAD: NORMAL" Background="#1D2633" Foreground="White"/>
                    </Grid>

                    <Border Grid.Row="2" Background="#151A22" BorderBrush="#293241" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LECTURA" Foreground="#8491A3" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LabCurrentText" Text="—" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0">
                                <TextBlock Text="ANÁLISIS" Foreground="#8491A3" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LabDetailsText" Text="Δ: — · puntaje: —" Foreground="#D5DCE6" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SESIÓN" Foreground="#8491A3" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LabCountText" Text="Registros: 0" Foreground="#D5DCE6" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#121821" BorderBrush="#293241" BorderThickness="1" CornerRadius="8" Padding="12" Width="250">
                            <StackPanel>
                                <TextBlock Text="MARCADORES MANUALES" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                                <Button Margin="0,10,0,0" Height="42" Click="MarkerEmpty_Click" Content="HABITACIÓN VACÍA" Background="#1D2633" Foreground="White"/>
                                <Button Margin="0,8,0,0" Height="42" Click="MarkerEntry_Click" Content="INGRESO" Background="#1D2633" Foreground="White"/>
                                <Button Margin="0,8,0,0" Height="42" Click="MarkerMove_Click" Content="MOVIMIENTO" Background="#1D2633" Foreground="White"/>
                                <Button Margin="0,8,0,0" Height="42" Click="MarkerExit_Click" Content="SALIDA" Background="#1D2633" Foreground="White"/>
                                <TextBlock Margin="0,14,0,0" Text="Los marcadores sirven como referencia para comparar la señal con lo que ocurrió realmente durante una prueba controlada." TextWrapping="Wrap" Foreground="#737F91" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Column="2" x:Name="LabRecentGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#121821" Foreground="White" RowBackground="#171C25" AlternatingRowBackground="#141A23" BorderBrush="#293241" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hora" Binding="{Binding TimeText}" Width="80"/>
                                <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="70"/>
                                <DataGridTextColumn Header="Δ dB" Binding="{Binding Delta, StringFormat={}{0:0.00}}" Width="75"/>
                                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0:0.00}}" Width="75"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="*"/>
                                <DataGridTextColumn Header="Marcador" Binding="{Binding MarkerText}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="RSSI puede variar por interferencias, puertas, objetos, roaming o cambios del enlace. Es una estimación experimental; no identifica personas ni determina una ubicación exacta." TextWrapping="Wrap" Foreground="#E0B37A" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Button Grid.Column="1" Width="115" Height="40" Click="ExportCsv_Click" Content="EXPORTAR CSV" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="2" Width="115" Height="40" Margin="8,0" Click="ExportJson_Click" Content="EXPORTAR JSON" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="3" Width="105" Height="40" Click="ClearLab_Click" Content="BORRAR" Background="#1D2633" Foreground="White"/>
                    </Grid>
                </Grid>
            </TabItem>


            <TabItem x:Name="CsiTab" Header="Wi‑Fi Sensing · Modo pared">
                <Grid Margin="10" Background="#04080E">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#081019" BorderBrush="#143345" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="WI‑FI SENSING OBSERVATORY" Foreground="#55FFD0" FontWeight="Bold" FontSize="15"/>
                                    <Border Margin="12,0,0,0" Padding="8,2" Background="#10291F" BorderBrush="#1B765E" BorderThickness="1" CornerRadius="8">
                                        <TextBlock x:Name="CsiModeBadge" Text="WI‑FI" Foreground="#53FFD0" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="CsiStatusText" Text="WI‑FI DIRECTO · listo para calibrar con el router conectado" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                                <TextBlock x:Name="CsiTargetText" Text="Usa RSSI del Wi‑Fi actual · sin ESP32 obligatorio" Foreground="#7793A4" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CsiDemoButton" Width="82" Height="36" Margin="0,0,7,0" Click="CsiDemo_Click" Content="DEMO" Background="#614A13" Foreground="#FFD874" BorderBrush="#B18724"/>
                                <Button x:Name="CsiRealButton" Width="88" Height="36" Margin="0,0,7,0" Click="CsiReal_Click" Content="WI‑FI" Background="#0D2A24" Foreground="#53FFD0" BorderBrush="#1C765E"/>
                                <Button x:Name="CsiRunButton" Width="124" Height="36" Margin="0,0,7,0" Click="CsiRun_Click" Content="CALIBRAR 25s" Background="#102332" Foreground="White" BorderBrush="#1D4C64"/>
                                <Button Width="88" Height="36" Click="CsiClear_Click" Content="REINICIAR" Background="#101820" Foreground="#AFC1CC" BorderBrush="#233644"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="205"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="270"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#071018" BorderBrush="#143345" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="SEÑAL / DETECCIÓN" Foreground="#62889B" FontSize="11" FontWeight="Bold"/>
                                <Border Margin="0,12,0,0" Background="#091A20" BorderBrush="#124B48" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="RSSI ACTUAL" Foreground="#688596" FontSize="10"/>
                                        <TextBlock x:Name="CsiHeartText" Text="— dBm" Foreground="#58FFC8" FontSize="25" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Background="#091A20" BorderBrush="#124B48" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="LÍNEA BASE" Foreground="#688596" FontSize="10"/>
                                        <TextBlock x:Name="CsiRespText" Text="— dBm" Foreground="#58FFC8" FontSize="25" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Background="#091A20" BorderBrush="#124B48" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="CONFIANZA RF" Foreground="#688596" FontSize="10"/>
                                        <TextBlock x:Name="CsiConfidenceText" Text="— %" Foreground="#58FFC8" FontSize="25" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Background="#091A20" BorderBrush="#124B48" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="ESTADO" Foreground="#688596" FontSize="10"/>
                                        <TextBlock x:Name="CsiMotionText" Text="SIN CALIBRAR" Foreground="#58FFC8" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Separator Margin="0,12" Background="#143345"/>
                                <TextBlock Text="La confianza RF mide qué tan fuerte se aparta la señal de la línea base. No equivale a probabilidad de que exista una persona." Foreground="#8EA4B0" TextWrapping="Wrap" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="2">
                            <controls:CsiSceneView x:Name="CsiScene" MinHeight="420"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,14">
                                <Button x:Name="CsiTrackingButton" Width="105" Height="30" Margin="4" Click="CsiTracking_Click" Content="INICIAR" Background="#0D2A24" Foreground="#56FFD1" BorderBrush="#1E765F"/>
                                <Button x:Name="CsiHeatButton" Width="105" Height="30" Margin="4" Click="CsiHeat_Click" Content="HEATMAP" Background="#0D2A24" Foreground="#56FFD1" BorderBrush="#1E765F"/>
                                <Button Width="105" Height="30" Margin="4" Content="WI‑FI DIRECT" Background="#0D2A24" Foreground="#56FFD1" BorderBrush="#1E765F" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="4" Background="#071018" BorderBrush="#143345" BorderThickness="1" CornerRadius="12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="2" Rows="2">
                                    <StackPanel Margin="4"><TextBlock Text="ENLACES" Foreground="#668395" FontSize="10"/><TextBlock x:Name="CsiNodesText" Text="0" Foreground="White" FontSize="22" FontWeight="Bold"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="MUESTRAS" Foreground="#668395" FontSize="10"/><TextBlock x:Name="CsiPacketsText" Text="0" Foreground="White" FontSize="22" FontWeight="Bold"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="Δ RSSI" Foreground="#668395" FontSize="10"/><TextBlock x:Name="CsiPresenceText" Text="—" Foreground="#58FFC8" FontSize="18" FontWeight="Bold"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock Text="SCORE" Foreground="#668395" FontSize="10"/><TextBlock x:Name="CsiPersonsText" Text="—" Foreground="#58FFC8" FontSize="18" FontWeight="Bold"/></StackPanel>
                                </UniformGrid>

                                <Border Grid.Row="2" Background="#08131C" BorderBrush="#143345" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="CÓMO PROBAR" Foreground="#55FFD0" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="1. Dejá router y equipo fijos.&#x0a;2. CALIBRAR 25s con el ambiente quieto.&#x0a;3. INICIAR.&#x0a;4. Probá movimiento entre router y equipo o con una pared en medio.&#x0a;5. Compará Δ RSSI y estado." Foreground="#A8BBC5" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Expander Grid.Row="4" Header="HARDWARE AVANZADO CSI (OPCIONAL)" Foreground="#7894A4" Background="#061017">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Si algún día agregás ESP32/CSI, el receptor UDP 5005 sigue incluido. No es necesario para el modo Wi‑Fi directo." Foreground="#7F96A2" TextWrapping="Wrap" FontSize="9" Margin="0,0,0,7"/>
                                        <DataGrid x:Name="CsiNodesGrid" Height="115" IsReadOnly="True" AutoGenerateColumns="False" Background="#061017" Foreground="#CFE0E8" BorderBrush="#143345" RowBackground="#08131C" AlternatingRowBackground="#061018" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="9">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nodo" Binding="{Binding NodeId}" Width="42"/>
                                                <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="*"/>
                                                <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="45"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Expander>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Background="#081019" BorderBrush="#143345" BorderThickness="1" CornerRadius="10" Padding="10">
                        <TextBlock Text="Wi‑Fi sensing experimental · Usa cambios RSSI del enlace actual. No genera una imagen óptica ni puede identificar o ubicar con precisión a una persona. Paredes, puertas, interferencia, roaming y el propio router pueden producir variaciones. Para pruebas, usá una red propia o autorizada." Foreground="#8EA4B0" TextWrapping="Wrap" FontSize="10"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Redes y canales">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="REDES CERCANAS" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ScanStatusText" Text="Usa el escaneo nativo de Windows. No intenta conectarse a ninguna red." Foreground="#AAB3C2" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="160" Height="42" Click="ScanWifi_Click" Content="📡  ESCANEAR" Background="#253044" Foreground="White"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="NetworksGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#121821" Foreground="White" RowBackground="#171C25" AlternatingRowBackground="#141A23" BorderBrush="#293241" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="*"/>
                                <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="160"/>
                                <DataGridTextColumn Header="Señal" Binding="{Binding SignalPercent, StringFormat={}{0}%}" Width="75"/>
                                <DataGridTextColumn Header="dBm aprox." Binding="{Binding ApproxRssi}" Width="90"/>
                                <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="65"/>
                                <DataGridTextColumn Header="Seguridad" Binding="{Binding Authentication}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="2" Background="#121821" BorderBrush="#293241" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="OCUPACIÓN DE CANALES" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                                <ListBox x:Name="ChannelsList" Margin="0,10,0,0" Background="Transparent" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>


            <TabItem x:Name="NetworkTab" Header="Kit de red">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="NetTargetBox" Height="40" VerticalContentAlignment="Center" Padding="10,0" Background="#151A22" Foreground="White" BorderBrush="#334155" ToolTip="Dominio o IP"/>
                        <Button Grid.Column="1" Width="95" Height="40" Margin="8,0,0,0" Click="NetDns_Click" Content="DNS" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="2" Width="110" Height="40" Margin="8,0,0,0" Click="NetPing_Click" Content="PING ×10" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="3" Width="115" Height="40" Margin="8,0,0,0" Click="NetTrace_Click" Content="TRACEROUTE" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="4" Width="110" Height="40" Margin="8,0,0,0" Click="ExportNetwork_Click" Content="GUARDAR TXT" Background="#1D2633" Foreground="White"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox x:Name="NetResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Padding="12" Background="#121821" Foreground="#D5DCE6" BorderBrush="#293241" Text="Ingresá un dominio o IP y elegí una prueba."/>

                            <Border Grid.Row="2" Background="#151A22" BorderBrush="#293241" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="CALCULADORA IPv4/CIDR" VerticalAlignment="Center" Foreground="#9AA6B6" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                        <TextBox Grid.Column="1" x:Name="CidrIpBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="192.168.1.10" Background="#10151D" Foreground="White" BorderBrush="#334155"/>
                                        <TextBlock Grid.Column="2" Text="/" VerticalAlignment="Center" Foreground="White" FontSize="18" Margin="8,0"/>
                                        <TextBox Grid.Column="3" x:Name="CidrPrefixBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="24" Background="#10151D" Foreground="White" BorderBrush="#334155"/>
                                        <Button Grid.Column="4" Width="95" Height="34" Margin="8,0,0,0" Click="CalculateCidr_Click" Content="CALCULAR" Background="#253044" Foreground="White"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" x:Name="CidrResultText" Text="Red, máscara, broadcast y rango aparecerán acá." Foreground="#C8D0DC" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="EQUIPOS EN TU LAN" Foreground="#9AA6B6" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LanStatusText" Text="Explora únicamente el /24 local mediante respuestas ICMP." Foreground="#AAB3C2" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="LanScanButton" Width="120" Height="40" Click="ScanLan_Click" Content="ESCANEAR LAN" Background="#253044" Foreground="White"/>
                            </Grid>

                            <DataGrid Grid.Row="2" x:Name="LanGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#121821" Foreground="White" RowBackground="#171C25" AlternatingRowBackground="#141A23" BorderBrush="#293241" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="110"/>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding HostName}" Width="*"/>
                                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="145"/>
                                    <DataGridTextColumn Header="OUI" Binding="{Binding Oui}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="4" Background="#151A22" BorderBrush="#293241" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="MAC / OUI" Foreground="#9AA6B6" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBox Grid.Column="1" x:Name="MacInputBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Background="#10151D" Foreground="White" BorderBrush="#334155" ToolTip="AA:BB:CC:DD:EE:FF"/>
                                        <Button Grid.Column="2" Width="90" Height="34" Margin="8,0,0,0" Click="InspectMac_Click" Content="ANALIZAR" Background="#253044" Foreground="White"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" x:Name="MacResultText" Text="Extrae el OUI y detecta MAC local/aleatorizada." Foreground="#C8D0DC" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Actualizaciones">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#101720" BorderBrush="#293241" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="GESTOR DE REPOSITORIOS" Foreground="#55FFD0" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="Cada repositorio se controla por separado. Puede comprobar releases/commits y descargar la actualización cuando cambia. La descarga queda en una carpeta local: nunca se ejecuta ni instala sola." Foreground="#AAB3C2" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Repositorios privados: R9 no guarda tokens de GitHub. Para esos repos se agregará autenticación segura más adelante." Foreground="#E0B37A" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RepositoryInputBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#151A22" Foreground="White" BorderBrush="#334155" ToolTip="https://github.com/owner/repo o owner/repo"/>
                        <TextBox Grid.Column="1" x:Name="RepositoryHoursBox" Height="38" Margin="8,0,0,0" Text="6" Padding="10,0" VerticalContentAlignment="Center" Background="#151A22" Foreground="White" BorderBrush="#334155" ToolTip="Intervalo en horas (1 a 168)"/>
                        <Button Grid.Column="2" Width="120" Height="38" Margin="8,0,0,0" Click="AddRepository_Click" Content="+ AGREGAR" Background="#0D2A24" Foreground="#55FFD0" BorderBrush="#1C765E"/>
                    </Grid>

                    <DataGrid Grid.Row="4" x:Name="RepositoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="#121821" Foreground="White" RowBackground="#171C25" AlternatingRowBackground="#141A23" BorderBrush="#293241" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Repositorio" Binding="{Binding Repository}" Width="1.6*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Enabled}" Width="62"/>
                            <DataGridCheckBoxColumn Header="Auto bajar" Binding="{Binding AutoDownload}" Width="78"/>
                            <DataGridTextColumn Header="Cada (h)" Binding="{Binding IntervalHours}" Width="70"/>
                            <DataGridTextColumn Header="Última versión" Binding="{Binding LatestName}" Width="1.1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Chequeado" Binding="{Binding DisplayLastChecked}" Width="95" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="1.5*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RepositoryStatusText" VerticalAlignment="Center" Foreground="#AAB3C2" Text="Listo." TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Width="95" Height="38" Margin="8,0,0,0" Click="SaveRepositories_Click" Content="GUARDAR" Background="#1D2633" Foreground="White"/>
                        <Button Grid.Column="2" Width="105" Height="38" Margin="8,0,0,0" Click="CheckSelectedRepository_Click" Content="REVISAR UNO" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="3" Width="110" Height="38" Margin="8,0,0,0" Click="CheckAllRepositories_Click" Content="REVISAR TODO" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="4" Width="95" Height="38" Margin="8,0,0,0" Click="RemoveRepository_Click" Content="QUITAR" Background="#3A1D24" Foreground="#FFD7DF"/>
                        <Button Grid.Column="5" Width="125" Height="38" Margin="8,0,0,0" Click="OpenRepositoryDownloads_Click" Content="DESCARGAS" Background="#0D2A24" Foreground="#55FFD0"/>
                    </Grid>
                </Grid>
            </TabItem>


            <TabItem Header="Descubrir">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#101720" BorderBrush="#293241" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DESCUBRIR · CATÁLOGOS OSINT" Foreground="#55FFD0" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="Vigila repositorios que funcionan como listas/catálogos. Guarda una línea base y, cuando el catálogo cambia, marca únicamente los repositorios nuevos. No descarga ni ejecuta herramientas de este catálogo por sí solo." Foreground="#AAB3C2" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Fuente inicial: Astrosp/Awesome-OSINT-List. Podés agregar otras listas de GitHub por separado." Foreground="#6EA8FF" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CatalogSourceInputBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#151A22" Foreground="White" BorderBrush="#334155" ToolTip="https://github.com/owner/catalogo o owner/catalogo"/>
                        <TextBox Grid.Column="1" x:Name="CatalogHoursBox" Height="38" Margin="8,0,0,0" Text="12" Padding="10,0" VerticalContentAlignment="Center" Background="#151A22" Foreground="White" BorderBrush="#334155" ToolTip="Intervalo en horas (1 a 168)"/>
                        <Button Grid.Column="2" Width="130" Height="38" Margin="8,0,0,0" Click="AddCatalogSource_Click" Content="+ FUENTE" Background="#0D2A24" Foreground="#55FFD0" BorderBrush="#1C765E"/>
                    </Grid>

                    <DataGrid Grid.Row="4" x:Name="CatalogSourceGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="#121821" Foreground="White" RowBackground="#171C25" AlternatingRowBackground="#141A23" BorderBrush="#293241" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fuente" Binding="{Binding Repository}" Width="1.8*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Enabled}" Width="62"/>
                            <DataGridTextColumn Header="Cada (h)" Binding="{Binding IntervalHours}" Width="70"/>
                            <DataGridTextColumn Header="Recursos" Binding="{Binding TotalCount}" Width="65" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nuevos" Binding="{Binding NewCount}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Chequeado" Binding="{Binding DisplayLastChecked}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="1.4*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CatalogStatusText" VerticalAlignment="Center" Foreground="#AAB3C2" Text="Listo para revisar fuentes." TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Width="120" Height="36" Margin="8,0,0,0" Click="CheckCatalogSources_Click" Content="REVISAR" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="2" Width="120" Height="36" Margin="8,0,0,0" Click="MarkDiscoveriesSeen_Click" Content="MARCAR VISTOS" Background="#1D2633" Foreground="White"/>
                        <Button Grid.Column="3" Width="105" Height="36" Margin="8,0,0,0" Click="RemoveCatalogSource_Click" Content="QUITAR" Background="#3A1D24" Foreground="#FFD7DF"/>
                    </Grid>

                    <DataGrid Grid.Row="8" x:Name="DiscoveryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" Background="#0D131B" Foreground="White" RowBackground="#151B24" AlternatingRowBackground="#111821" BorderBrush="#293241" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="70"/>
                            <DataGridTextColumn Header="Repositorio descubierto" Binding="{Binding Repository}" Width="1.6*"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="1.2*"/>
                            <DataGridTextColumn Header="Fuente" Binding="{Binding Source}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Seleccioná un recurso para abrirlo o sumarlo al gestor de actualizaciones. Al agregarlo queda en SOLO AVISA por seguridad." Foreground="#7E8998" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Width="125" Height="38" Margin="8,0,0,0" Click="OpenDiscovery_Click" Content="ABRIR GITHUB" Background="#253044" Foreground="White"/>
                        <Button Grid.Column="2" Width="190" Height="38" Margin="8,0,0,0" Click="AddDiscoveryToUpdates_Click" Content="+ A ACTUALIZACIONES" Background="#0D2A24" Foreground="#55FFD0"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
